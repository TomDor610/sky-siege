{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{4}$/) && newData.child('host').val() === auth.uid && (!data.exists() || data.child('createdAt').val() < now - 600000)",
          ".validate": "newData.hasChildren(['v', 'host', 'createdAt', 'state'])",
          "v": { ".validate": "newData.val() === 1" },
          "host": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.val() === now" },
          "state": { ".validate": "newData.val() === 'lobby'" },
          "guest": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && data.parent().child('host').val() !== auth.uid && data.parent().child('createdAt').val() >= now - 600000) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
            ".validate": "newData.isString()"
          },
          "$other": { ".validate": false }
        },
        "players": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || root.child('rooms').child($code).child('meta/guest').val() === auth.uid)",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid && newData.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || root.child('rooms').child($code).child('meta/guest').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9א-ת _-]*$/)" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
