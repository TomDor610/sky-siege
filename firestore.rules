rules_version = '2';

// Sky Siege cloud saves: one document per player, users/{uid}.
// A signed-in player (anonymous or Google) can read and write ONLY their own document.
// Writes must have the expected shape; nothing can be deleted; everything else is closed.
//
// Note: rules protect players from each other, not a player from editing their own save
// (there is no trusted server on the Spark plan). Keep that in mind for leaderboards.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'prog', 'build', 'fort', 'buildAt', 'updatedAt'])
        && d.keys().hasAll(['v', 'prog', 'build', 'fort', 'updatedAt'])
        && d.v is int && d.v >= 1 && d.v < 100
        && d.prog is map && d.build is map && d.fort is map
        && d.prog.keys().hasOnly(['coins', 'coinsEarned', 'coinsSpent', 'epoch', 'upg', 'xp',
                                  'styles', 'unl', 'wins', 'duelWins', 'best', 'nick', 'friends'])
        && (!('nick' in d.prog) || (d.prog.nick is string && d.prog.nick.size() <= 16))
        && (!('friends' in d.prog) || (d.prog.friends is list && d.prog.friends.size() <= 200))
        && d.prog.coins is number && d.prog.xp is number
        && d.prog.upg is map && d.prog.styles is map && d.prog.unl is map
        && d.prog.wins is map && d.prog.duelWins is map && d.prog.best is map
        && d.build.size() <= 12
        && d.fort.keys().hasOnly(['slots', 'walls'])
        && d.fort.slots is list && d.fort.slots.size() <= 5
        && (!('buildAt' in d) || d.buildAt is number)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSave();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- leaderboard
    // Public read. Each player writes only their own row, with plausible values.
    // (Rules can check that a value is plausible, not that it was really earned.)
    function validTime(t) {          // seconds, 0 = no record yet
      return t is number && (t == 0 || (t >= 3 && t <= 10000));
    }
    function validCampaign(d, k) {   // level beaten + fastest time + matching sort score
      let lvl = d.lvl[k];
      let best = d.best[k];
      return lvl is int && lvl >= 0 && lvl <= 500
        && validTime(best) && ((lvl == 0) == (best == 0))
        && d.score[k] == (lvl == 0 ? 0 : lvl * 100000 + 99999 - math.round(best * 10));
    }
    function validRow() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'code', 'rank', 'lvl', 'best', 'duelWins', 'score', 'friends', 'updatedAt'])
        && d.keys().hasAll(['name', 'code', 'rank', 'lvl', 'best', 'duelWins', 'score', 'friends', 'updatedAt'])
        && d.code is string && d.code.matches('^[A-Z0-9]{2,8}$')
        && request.auth.uid.upper().matches(d.code + '.*')
        && d.friends is list && d.friends.size() <= 200
        && d.lvl is map && d.best is map && d.score is map
        && d.lvl.keys().hasOnly(['easy', 'medium', 'hard']) && d.lvl.keys().hasAll(['easy', 'medium', 'hard'])
        && d.best.keys().hasOnly(['easy', 'medium', 'hard']) && d.best.keys().hasAll(['easy', 'medium', 'hard'])
        && d.score.keys().hasOnly(['easy', 'medium', 'hard', 'duel']) && d.score.keys().hasAll(['easy', 'medium', 'hard', 'duel'])
        && d.duelWins is int && d.duelWins >= 0 && d.duelWins <= 100000
        && d.rank is int && d.rank >= 1 && d.rank <= 20
        && (
          // on the board: a real nickname and consistent scores
          (d.name is string && d.name.size() >= 2 && d.name.size() <= 16
            && d.name.matches('^[A-Za-z0-9א-ת _-]+$')
            && validCampaign(d, 'easy') && validCampaign(d, 'medium') && validCampaign(d, 'hard')
            && d.score.duel == d.duelWins)
          ||
          // left the board: no name, every score -1 (sinks below everyone)
          (d.name == '' && d.score.easy == -1 && d.score.medium == -1 && d.score.hard == -1 && d.score.duel == -1)
        )
        && d.updatedAt == request.time;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      // at most one write every 20 seconds per player
      allow create: if isOwner(uid) && validRow();
      allow update: if isOwner(uid) && validRow()
        && request.time > resource.data.updatedAt + duration.value(20, 's');
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
